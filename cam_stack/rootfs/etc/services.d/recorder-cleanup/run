#!/usr/bin/with-contenv bashio
# Rolling buffer: delete recordings older than record_hours, and the oldest ones
# whenever /share drops below record_min_free_gb.
DIR=/share/camrec
HOURS="$(bashio::config 'record_hours')"
MIN_FREE_GB="$(bashio::config 'record_min_free_gb')"
mkdir -p "${DIR}"
bashio::log.info "recorder-cleanup: keep ${HOURS}h, min free ${MIN_FREE_GB} GB"

while true; do
    find "${DIR}" -type f -name '*.mkv' -mmin +$((HOURS * 60)) -delete
    while [ "$(df -Pk /share | awk 'NR==2 {print int($4 / 1048576)}')" -lt "${MIN_FREE_GB}" ]; do
        oldest="$(ls -1 "${DIR}"/*.mkv 2>/dev/null | head -n 1)"
        [ -n "${oldest}" ] || break
        bashio::log.warning "recorder-cleanup: low disk, deleting ${oldest}"
        rm -f "${oldest}"
    done
    sleep 300
done
