#!/usr/bin/with-contenv bashio
# Continuous recording of the DFR1154 video into 5-minute H.264 MP4 segments under
# /media/camrec, so they show up in HA's Media browser (My media → camrec) and play
# on iOS/Safari. Pulled from the local go2rtc RTSP restream, so the camera keeps a
# single client.
#
# Two stages: (1) decode MJPEG → H.264 on the Pi 4's hardware encoder (/dev/video11,
# ~5% of one core; libx264 fallback elsewhere) into an MPEG-TS pipe; (2) stream-copy
# that into MP4 segments. Feed the encoder NV12: a plain yuvj420p→yuv420p relabel
# hands it the MJPEG decoder's buffers as-is and every frame comes out as stripes.
# The split is needed because h264_v4l2m2m emits SPS/PPS only
# once, so a single-process segmenter writes undecodable MP4s after the first one.
if ! bashio::config.true 'record_enabled'; then
    bashio::log.info "recorder disabled (record_enabled=false)"
    exec sleep infinity
fi

DIR=/media/camrec
BITRATE="$(bashio::config 'record_bitrate_kbps')"
FPS="$(bashio::config 'record_fps')"
mkdir -p "${DIR}"
sleep 10   # let go2rtc come up

if [ -e /dev/video11 ]; then
    ENC=(-c:v h264_v4l2m2m -b:v "${BITRATE}k" -g $((FPS * 2)))
    bashio::log.info "recorder: hardware H.264 (v4l2m2m), ${BITRATE} kbit/s, ${FPS} fps → ${DIR}"
else
    ENC=(-c:v libx264 -preset veryfast -b:v "${BITRATE}k" -g $((FPS * 2)))
    bashio::log.warning "recorder: /dev/video11 missing, software x264 (CPU heavy) → ${DIR}"
fi

while true; do
    ffmpeg -hide_banner -v error -nostdin \
        -rtsp_transport tcp -timeout 15000000 -use_wallclock_as_timestamps 1 \
        -i rtsp://127.0.0.1:8554/dfr1154 \
        -map 0:v -vf "fps=${FPS},format=nv12" "${ENC[@]}" \
        -f mpegts - \
    | ffmpeg -hide_banner -v error -nostdin -f mpegts -i - \
        -c copy -f segment -segment_time 300 -segment_atclocktime 1 \
        -segment_format mp4 -segment_format_options movflags=+faststart \
        -reset_timestamps 1 -strftime 1 \
        "${DIR}/%Y-%m-%d_%H-%M-%S.mp4"
    bashio::log.warning "recorder: ffmpeg pipeline exited, restarting in 10s"
    sleep 10
done
